    <!-- Connect -->
    <string name="connect_title_line1">Your music,</string>
    <string name="connect_title_line2">from your server.</string>
    <string name="connect_body">Connect to the Downtify you run at home. Everything streams from there, and stays yours.</string>
    <string name="connect_address_label">Server address</string>
    <string name="connect_address_hint">The same address you open Downtify at in a browser.</string>
